{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "--registry", "https://registry.npmjs.org", "chrome-devtools-mcp@0.16.0"]
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@1.0.31"],
      "env": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}" }
    },
    "next-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "next-devtools-mcp@0.4.0"]
    },
    "lighthouse": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "lighthouse-mcp"]
    },
    "github": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "github-actions": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "github-actions-mcp"],
      "env": { "GITHUB_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    "mcp-lambdatest": {
      "type": "http",
      "url": "https://mcp.lambdatest.com/mcp"
    }
  }
}
